# ============================================================
# HelpFund Environment Variables
# Copy this file to .env.local and fill in the values.
# Never commit real secrets.
# ============================================================

# Application
APP_URL=http://localhost:3000
NODE_ENV=development

# Authentication
# Generate a strong random secret: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string

# Turso Database (required for production)
# Create a database at https://turso.tech
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# For local development without Turso you can use:
# TURSO_DATABASE_URL=file:local.db

# Email (optional – notification abstraction works without it)
# EMAIL_PROVIDER=resend | console
# EMAIL_FROM=noreply@helpfund.ng
# RESEND_API_KEY=

# Object Storage (optional – campaign images)
# STORAGE_PROVIDER=local | s3 | r2
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_ENDPOINT=
# STORAGE_PUBLIC_URL=

# Payment (intentionally not activated yet)
# PAYMENT_PROVIDER=test | paystack | flutterwave
# PAYSTACK_SECRET_KEY=
# FLUTTERWAVE_SECRET_KEY=

# Clerk Authentication
# Get these from https://dashboard.clerk.com → your app → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional Clerk URLs (defaults work for most cases)
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
# NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard
